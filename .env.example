HOST=127.0.0.1
PORT=4782
REDIS_URL=redis://127.0.0.1:6379
LOG_LEVEL=info
WORKSPACE_ID=local

# Frontend development only: add Vite's exact loopback origin explicitly when
# the daemon runs alongside `pnpm dev:dashboard`. Production defaults remain unchanged.
# LUWI_ALLOWED_ORIGINS=http://127.0.0.1:4782,http://localhost:4782,http://127.0.0.1:4783

# Canonical LUWI state and native-agent home override. Leave unset for normal
# ~/.luwi and OS home behavior. Sandboxed demos set both to temporary roots.
# LUWI_HOME=C:\path\to\sandbox\.luwi
# LUWI_NATIVE_HOME=C:\path\to\sandbox\agent-home

# Optional absolute native capability roots. Use the OS path delimiter:
# semicolon on Windows and colon on macOS/Linux. Scans are explicit, bounded,
# read-only, and never execute discovered files.
# LUWI_CAPABILITY_ROOTS=C:\path\to\skills;D:\shared\agent-skills

# Local native-config snapshots are pruned to this completed-snapshot bound.
LUWI_CONFIG_SNAPSHOT_RETENTION_COUNT=50

# Phase 4 local Git observation and derived-intelligence retention. The Git
# observer uses a fixed read-only command allowlist and performs no fetch.
LUWI_GIT_COMMAND_TIMEOUT_MS=5000
LUWI_GIT_SCAN_INTERVAL_MS=300000
LUWI_USAGE_RETENTION_DAYS=30
LUWI_GIT_OBSERVATION_RETENTION_COUNT=100
LUWI_GRAPH_GENERATION_RETENTION_COUNT=2

# Human-approved structural context optimization evidence windows and bounds.
LUWI_OPTIMIZATION_MIN_BASELINE_SESSIONS=3
LUWI_OPTIMIZATION_MIN_POST_SESSIONS=3
LUWI_OPTIMIZATION_MIN_OBSERVATION_HOURS=24
LUWI_OPTIMIZATION_MAX_FINDINGS_PER_RUN=100
LUWI_OPTIMIZATION_MAX_PROPOSALS_PER_RUN=25
LUWI_OPTIMIZATION_OVERSIZED_CONTEXT_TOKENS=8000

# Single-daemon ownership. Renewal must be shorter than the TTL.
LUWI_DAEMON_OWNER_TTL_MS=15000
LUWI_DAEMON_OWNER_RENEW_INTERVAL_MS=5000

# Session presence, expiry sweep, and durable heartbeat event sampling.
LUWI_SESSION_PRESENCE_TTL_MS=15000
LUWI_PRESENCE_SWEEP_INTERVAL_MS=1000
LUWI_HEARTBEAT_EVENT_INTERVAL_MS=30000

# Consumer-group relay and stale pending recovery.
LUWI_CONSUMER_CLAIM_IDLE_MS=30000
LUWI_RELAY_BLOCK_MS=1000
LUWI_RELAY_BATCH_SIZE=100

# Per-client WebSocket safety limits.
LUWI_WS_QUEUE_LIMIT=256
LUWI_WS_SEND_TIMEOUT_MS=1000
LUWI_WS_MAX_PAYLOAD_BYTES=65536
LUWI_WS_MAX_BUFFERED_BYTES=1048576

# Comma-separated exact loopback HTTP origins. Defaults to the daemon's
# 127.0.0.1 and localhost origins on PORT when omitted.
# LUWI_ALLOWED_ORIGINS=http://127.0.0.1:4782,http://localhost:4782

# Periodic bounded retention. Global trimming is deferred while the relay group
# has pending entries, lag, invalid metadata, or an unhealthy relay.
LUWI_STREAM_MAXLEN_GLOBAL=100000
LUWI_STREAM_MAXLEN_PROJECT=50000
LUWI_STREAM_MAXLEN_DEAD_LETTER=10000
LUWI_RETENTION_INTERVAL_MS=60000

# Message deadlines and conservative terminal/inbox retention.
LUWI_MESSAGE_MAX_CONTENT_BYTES=32768
LUWI_MESSAGE_MAX_SUBJECT_BYTES=512
LUWI_MESSAGE_MAX_RESPONSE_BYTES=65536
LUWI_MESSAGE_MAX_EVIDENCE_ITEMS=32
LUWI_MESSAGE_DEFAULT_TIMEOUT_MS=120000
LUWI_MESSAGE_MAX_TIMEOUT_MS=86400000
LUWI_MESSAGE_TIMEOUT_SWEEP_INTERVAL_MS=1000
LUWI_MESSAGE_TIMEOUT_BATCH_SIZE=100
LUWI_TERMINAL_MESSAGE_RETENTION_MS=604800000
LUWI_MESSAGE_IDEMPOTENCY_RETENTION_MS=86400000
LUWI_INBOX_CLAIM_LIMIT=10
LUWI_INBOX_BLOCK_MS=5000
LUWI_INBOX_MIN_IDLE_MS=15000
LUWI_INBOX_MAX_CLAIM_LIMIT=100
LUWI_SESSION_INBOX_MAXLEN=10000

# Draining shutdown and bounded Redis recovery.
LUWI_DRAIN_TIMEOUT_MS=5000
LUWI_RECONNECT_INITIAL_MS=250
LUWI_RECONNECT_MAX_MS=5000

# Thin stdio MCP adapter. LUWI_SESSION_ID must name an existing online,
# non-terminal session. The adapter only calls loopback daemon HTTP.
LUWI_DAEMON_URL=http://127.0.0.1:4782
# LUWI_SESSION_ID=<registered-session-id>
LUWI_MCP_REQUEST_TIMEOUT_MS=30000

# Integration tests require an explicit Redis target. Redis Function libraries
# are server-scoped, so prefer a disposable dedicated server.
# LUWI_TEST_REDIS_URL=redis://127.0.0.1:6379/15
# LUWI_TEST_ALLOW_SHARED_REDIS_FUNCTIONS=true
